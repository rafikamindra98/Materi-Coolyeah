import pandas as pd
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

# Lilliefors Critical Values are approximated/empirical.
# They do not have a simple exact inverse CDF function in scipy like t or F.
# We will use the standard table values up to n=30, and the asymptotic formulas for n>30.

n_vals = list(range(4, 31))

# Standard critical values for n = 4 to 30 based on typical Lilliefors tables
# Columns are alpha: 0.01, 0.05, 0.10, 0.15, 0.20
lilliefors_data = {
    4: [0.417, 0.381, 0.352, 0.319, 0.300],
    5: [0.405, 0.337, 0.315, 0.299, 0.285],
    6: [0.364, 0.319, 0.294, 0.277, 0.265],
    7: [0.348, 0.300, 0.276, 0.258, 0.247],
    8: [0.331, 0.285, 0.261, 0.244, 0.233],
    9: [0.311, 0.271, 0.249, 0.233, 0.223],
    10: [0.294, 0.258, 0.239, 0.224, 0.215],
    11: [0.284, 0.249, 0.230, 0.217, 0.206],
    12: [0.275, 0.242, 0.223, 0.212, 0.199],
    13: [0.268, 0.234, 0.214, 0.202, 0.190],
    14: [0.261, 0.227, 0.207, 0.194, 0.183],
    15: [0.257, 0.220, 0.201, 0.187, 0.177],
    16: [0.250, 0.213, 0.195, 0.182, 0.173],
    17: [0.245, 0.206, 0.189, 0.177, 0.169],
    18: [0.239, 0.200, 0.184, 0.173, 0.166],
    19: [0.235, 0.195, 0.179, 0.169, 0.163],
    20: [0.231, 0.190, 0.174, 0.166, 0.160],
    21: [0.226, 0.187, 0.170, 0.163, 0.156],
    22: [0.221, 0.183, 0.166, 0.160, 0.153],
    23: [0.216, 0.180, 0.163, 0.156, 0.151],
    24: [0.213, 0.176, 0.160, 0.153, 0.149],
    25: [0.210, 0.173, 0.158, 0.150, 0.146],
    26: [0.206, 0.171, 0.155, 0.148, 0.143],
    27: [0.203, 0.168, 0.153, 0.146, 0.141],
    28: [0.199, 0.166, 0.151, 0.144, 0.138],
    29: [0.196, 0.163, 0.149, 0.142, 0.136],
    30: [0.193, 0.161, 0.147, 0.141, 0.136] # Using common table values for n=30
}

alpha_levels = [0.01, 0.05, 0.10, 0.15, 0.20]

output_path = "Tabel_Kritis_Lilliefors.xlsx"
wb = openpyxl.Workbook()
ws = wb.active
ws.title = "Tabel Lilliefors"

# Define Styles
title_font = Font(bold=True, size=12, color="333333")
header_font = Font(bold=True, color="FFFFFF")
subheader_font = Font(bold=True, color="333333")
fill_dark = PatternFill(start_color="3B4252", end_color="3B4252", fill_type="solid")
fill_light = PatternFill(start_color="E5E9F0", end_color="E5E9F0", fill_type="solid")
align_center = Alignment(horizontal="center", vertical="center", wrap_text=True)
border_thin = Border(left=Side(style='thin', color="CCCCCC"), 
                     right=Side(style='thin', color="CCCCCC"), 
                     top=Side(style='thin', color="CCCCCC"), 
                     bottom=Side(style='thin', color="CCCCCC"))

num_cols = len(alpha_levels)
last_col_letter = openpyxl.utils.get_column_letter(num_cols + 1)

# Headers
ws.cell(row=1, column=1, value="Tabel Nilai Kritis L untuk Uji Lilliefors")
ws.cell(row=2, column=1, value="Ukuran Sampel (n)")
ws.cell(row=2, column=2, value="Taraf Nyata (α)")

for col, val in enumerate(alpha_levels, start=2):
    ws.cell(row=3, column=col, value=val)

# Populate Data for n <= 30
current_row = 4
for n in n_vals:
    ws.cell(row=current_row, column=1, value=n)
    for col, idx in enumerate(range(len(alpha_levels)), start=2):
        ws.cell(row=current_row, column=col, value=lilliefors_data[n][idx]).number_format = '0.000'
    current_row += 1

# Add n > 30 asymptotic formulas
ws.cell(row=current_row, column=1, value="n > 30")
formulas = ["1.031 / √n", "0.886 / √n", "0.805 / √n", "0.768 / √n", "0.736 / √n"]
for col, formula in enumerate(formulas, start=2):
    ws.cell(row=current_row, column=col, value=formula)

# Merges and Styles
ws.merge_cells(f'A1:{last_col_letter}1')
ws['A1'].font = title_font
ws['A1'].alignment = align_center

ws.merge_cells('A2:A3')
ws['A2'].font = header_font
ws['A2'].fill = fill_dark
ws['A2'].alignment = align_center

ws.merge_cells(f'B2:{last_col_letter}2')
ws['B2'].font = header_font
ws['B2'].fill = fill_dark
ws['B2'].alignment = align_center

for col in range(2, num_cols + 2):
    cell = ws.cell(row=3, column=col)
    cell.font = subheader_font
    cell.fill = fill_light
    cell.alignment = align_center

# Borders and formatting
for row in ws.iter_rows(min_row=2, max_row=ws.max_row, min_col=1, max_col=num_cols + 1):
    for cell in row:
        cell.border = border_thin
        if cell.row >= 4:
            if cell.column == 1:
                cell.font = subheader_font
                cell.fill = fill_light
            cell.alignment = align_center

# Widths
ws.column_dimensions['A'].width = 18
for col in range(2, num_cols + 2):
    col_letter = openpyxl.utils.get_column_letter(col)
    ws.column_dimensions[col_letter].width = 12

ws.freeze_panes = 'B4'

wb.save(output_path)
output_path
