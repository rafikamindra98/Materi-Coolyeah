import pandas as pd
import numpy as np
from scipy.stats import f
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

# Define degrees of freedom for numerator (df1)
df1_vals = list(range(1, 11)) + [15, 20]

# Define degrees of freedom for denominator (df2)
df2_vals = list(range(1, 21)) + list(range(25, 405, 5))

# Typically F tables have multiple pages for different alpha levels (0.05 and 0.01 are common)
# Let's create one sheet for alpha = 0.05 and another for alpha = 0.01
alphas = [0.05, 0.01]

output_path = "Tabel_Distribusi_F_Kustom.xlsx"
wb = openpyxl.Workbook()

# Define Styles
title_font = Font(bold=True, size=12, color="333333")
header_font = Font(bold=True, color="FFFFFF")
subheader_font = Font(bold=True, color="333333")
fill_dark = PatternFill(start_color="3B4252", end_color="3B4252", fill_type="solid")
fill_light = PatternFill(start_color="E5E9F0", end_color="E5E9F0", fill_type="solid")
align_center = Alignment(horizontal="center", vertical="center", wrap_text=True)
border_thin = Border(left=Side(style='thin', color="CCCCCC"), 
                     right=Side(style='thin', color="CCCCCC"), 
                     top=Side(style='thin', color="CCCCCC"), 
                     bottom=Side(style='thin', color="CCCCCC"))

num_cols = len(df1_vals)
last_col_letter = openpyxl.utils.get_column_letter(num_cols + 1)

first_sheet = True

for alpha in alphas:
    if first_sheet:
        ws = wb.active
        first_sheet = False
    else:
        ws = wb.create_sheet()
        
    ws.title = f"Tabel F (alpha={alpha})"
    
    # Headers
    ws.cell(row=1, column=1, value=f"Tabel L.4 Nilai Persentil untuk Distribusi F (α = {alpha})")
    ws.cell(row=2, column=1, value="dk Penyebut (v2)")
    ws.cell(row=2, column=2, value="dk Pembilang (v1)")
    
    for col, v1 in enumerate(df1_vals, start=2):
        ws.cell(row=3, column=col, value=v1)
        
    # Populate Data
    current_row = 4
    for v2 in df2_vals:
        ws.cell(row=current_row, column=1, value=v2)
        for col, v1 in enumerate(df1_vals, start=2):
            val = f.ppf(1 - alpha, v1, v2)
            ws.cell(row=current_row, column=col, value=val).number_format = '0.00'
        current_row += 1

    # Merges and Styles
    ws.merge_cells(f'A1:{last_col_letter}1')
    ws['A1'].font = title_font
    ws['A1'].alignment = align_center

    ws.merge_cells('A2:A3')
    ws['A2'].font = header_font
    ws['A2'].fill = fill_dark
    ws['A2'].alignment = align_center

    ws.merge_cells(f'B2:{last_col_letter}2')
    ws['B2'].font = header_font
    ws['B2'].fill = fill_dark
    ws['B2'].alignment = align_center
    
    # Apply Styles to Subheaders
    for col in range(2, num_cols + 2):
        cell = ws.cell(row=3, column=col)
        cell.font = subheader_font
        cell.fill = fill_light
        cell.alignment = align_center

    # Borders and formatting
    for row in ws.iter_rows(min_row=2, max_row=ws.max_row, min_col=1, max_col=num_cols + 1):
        for cell in row:
            cell.border = border_thin
            if cell.row >= 4:
                if cell.column == 1:
                    cell.font = subheader_font
                    cell.fill = fill_light
                cell.alignment = align_center

    # Widths
    ws.column_dimensions['A'].width = 15
    for col in range(2, num_cols + 2):
        col_letter = openpyxl.utils.get_column_letter(col)
        ws.column_dimensions[col_letter].width = 8

    ws.freeze_panes = 'B4'

wb.save(output_path)
output_path
